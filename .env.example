# Copy this file to .env and fill it in. Never commit .env.

# --- Data (phases 2-3). https://dataforseo.com  (pay as you go) ---
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# --- AI. Pick ONE ---
# a) Claude API key (https://console.anthropic.com). Costs count against the cap below.
ANTHROPIC_API_KEY=
# b) or leave it empty and install Claude Code (`claude` on PATH): runs on your Claude subscription.
# VM_AI_PROVIDER=auto        # auto | anthropic | claude-cli
# VM_MODEL_SMART=claude-sonnet-5-5
# VM_MODEL_FAST=claude-haiku-5-5

# --- Money caps (hard stops) ---
VM_MAX_USD_PER_IDEA=5        # cap for a FULL check (all paid API spend for one idea)
VM_LIGHT_MAX_USD=0.5         # cap for a QUICK check
VM_DEEP_MAX_USD=10           # cap for a DEEP check
VM_PHASE1_MAX_USD=0.5        # phase 1 (blocks 01-05)
# VM_COUNT_CLI_COST=0        # 1 = also count Claude Code CLI cost against the cap

# --- Research knobs ---
# VM_MAX_SERPS=60            # live SERPs in block 08 (about $0.002-0.004 each)
# VM_SERP_DEPTH=20
# VM_MIN_MARKET_USD_MONTH=1000      # under this much money a month reachable through Google search: KILL as a search business
# VM_TARGET_MARKET_USD_MONTH=10000  # the market size we want; between the two the most an idea gets is TEST FIRST
# VM_GOOD_CASE_SHARE=0.35           # the most a new site may take of the reachable market in year one (forecast good case)
# VM_ASSUMED_CONVERSION=0.01 # visitor -> buyer, used for the bottom-up market (labelled as an assumption)
# VM_MARKET_COUNTRIES=us,gb,ca,au
# VM_CACHE_DAYS=30

# 1 = how hard an idea is to build counts in the first-look score again (default 0: build time never counts against an idea)
# VM_COUNT_BUILD_EFFORT=0

# Revenue proof (recommended): real businesses with payment-verified revenue, from trustmrr.com (developer dashboard -> API key).
# Then pull the data once: python vm.py proof sync --min 500 --max 5000000
# TRUSTMRR_API_KEY=
# A real business in the niche earning at least this much in 30 days proves the niche pays, even when search is small
# VM_PROOF_MIN_USD=5000
# Optional: a command that reads a page in a real browser and prints JSON {"status": "ok", "text": "..."}; it gets the URL and --max N.
# Used to count rivals' ads in the Meta Ad Library and the Google Ads Transparency Center.
# VM_BROWSER_CMD=

# Most data money per calendar day, over every idea, every data folder and every lookup run by hand. See: python vm.py spend
# VM_DAY_MAX_USD=5
