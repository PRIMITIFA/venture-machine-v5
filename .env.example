# Copy this file to .env and fill it in. Never commit .env.

# --- Data (phases 2-3). https://dataforseo.com  (pay as you go) ---
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# --- AI. Pick ONE ---
# a) Claude API key (https://console.anthropic.com). Costs count against the cap below.
ANTHROPIC_API_KEY=
# b) or leave it empty and install Claude Code (`claude` on PATH): runs on your Claude subscription.
# VM_AI_PROVIDER=auto        # auto | anthropic | claude-cli
# VM_MODEL_SMART=claude-sonnet-5-5
# VM_MODEL_FAST=claude-haiku-5-5

# --- Money caps (hard stops) ---
VM_MAX_USD_PER_IDEA=5        # cap for a FULL check (all paid API spend for one idea)
VM_LIGHT_MAX_USD=0.5         # cap for a QUICK check
VM_DEEP_MAX_USD=10           # cap for a DEEP check
VM_PHASE1_MAX_USD=0.5        # phase 1 (blocks 01-05)
# VM_COUNT_CLI_COST=0        # 1 = also count Claude Code CLI cost against the cap

# --- Research knobs ---
# VM_MAX_SERPS=60            # live SERPs in block 08 (about $0.002-0.004 each)
# VM_SERP_DEPTH=20
# VM_MIN_MARKET_USD=12000    # smallest search market (USD a year) worth building for; not a sales goal
# VM_ASSUMED_CONVERSION=0.01 # visitor -> buyer, used for the bottom-up market (labelled as an assumption)
# VM_MARKET_COUNTRIES=us,gb,ca,au
# VM_CACHE_DAYS=30
